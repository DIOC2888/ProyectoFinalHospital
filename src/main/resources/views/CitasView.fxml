<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@../css/estilos.css" fx:controller="org.example.proyectofinalhospital.controller.CitasController" prefHeight="660.0" prefWidth="940.0" spacing="14.0" styleClass="modulo">
    <padding>
        <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
    </padding>
    <children>
        <Label styleClass="titulo" text="Gestión de citas" />
        <Label styleClass="subtitulo" text="Programe, actualice y cancele las citas médicas." />

        <!-- ============ FORMULARIO ============ -->
        <VBox spacing="14.0" styleClass="card">
            <children>
                <GridPane hgap="14.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="130.0" prefWidth="150.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                        <ColumnConstraints minWidth="130.0" prefWidth="150.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                    </columnConstraints>
                    <children>
            <Label styleClass="campo-label" text="Paciente" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <ComboBox fx:id="cmbPaciente" maxWidth="Infinity" promptText="Seleccione el paciente" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label styleClass="campo-label" text="Médico" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <ComboBox fx:id="cmbMedico" maxWidth="Infinity" promptText="Seleccione el médico" GridPane.columnIndex="3" GridPane.rowIndex="0" />
            <Label styleClass="campo-label" text="Fecha" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <DatePicker fx:id="dpFecha" maxWidth="Infinity" promptText="dd/mm/aaaa" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label styleClass="campo-label" text="Hora" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <ComboBox fx:id="cmbHora" maxWidth="Infinity" promptText="Seleccione la hora" GridPane.columnIndex="3" GridPane.rowIndex="1">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="08:00" />
                        <String fx:value="08:30" />
                        <String fx:value="09:00" />
                        <String fx:value="09:30" />
                        <String fx:value="10:00" />
                        <String fx:value="10:30" />
                        <String fx:value="11:00" />
                        <String fx:value="11:30" />
                        <String fx:value="12:00" />
                        <String fx:value="12:30" />
                        <String fx:value="13:00" />
                        <String fx:value="13:30" />
                        <String fx:value="14:00" />
                        <String fx:value="14:30" />
                        <String fx:value="15:00" />
                        <String fx:value="15:30" />
                        <String fx:value="16:00" />
                        <String fx:value="16:30" />
                        <String fx:value="17:00" />
                        <String fx:value="17:30" />
                    </FXCollections>
                </items>
            </ComboBox>
            <Label styleClass="campo-label" text="Motivo" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="txtMotivo" promptText="Motivo de la consulta" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label styleClass="campo-label" text="Estado" GridPane.columnIndex="2" GridPane.rowIndex="2" />
            <ComboBox fx:id="cmbEstado" maxWidth="Infinity" promptText="Seleccione el estado" GridPane.columnIndex="3" GridPane.rowIndex="2">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="PROGRAMADA" />
                        <String fx:value="CONFIRMADA" />
                        <String fx:value="COMPLETADA" />
                        <String fx:value="CANCELADA" />
                        <String fx:value="NO_ASISTIO" />
                    </FXCollections>
                </items>
            </ComboBox>
            <Label styleClass="campo-label" text="Observaciones" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <TextArea fx:id="txtObservaciones" prefRowCount="3" wrapText="true" promptText="Observaciones (opcional)" GridPane.columnIndex="1" GridPane.rowIndex="3" GridPane.columnSpan="3" />
                    </children>
                </GridPane>
                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnProgramar" mnemonicParsing="false" onAction="#programar" styleClass="btn-primary" text="Programar" />
                        <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#actualizar" styleClass="btn-secondary" text="Actualizar" />
                        <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiar" styleClass="btn-secondary" text="Limpiar" />
                        <Button fx:id="btnCancelarCita" mnemonicParsing="false" onAction="#cancelarCita" styleClass="btn-danger" text="Cancelar cita" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- ============ LISTADO ============ -->
        <VBox spacing="10.0" styleClass="card" VBox.vgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label styleClass="campo-label" text="Buscar:" />
                    <TextField fx:id="txtBuscar" promptText="Buscar por paciente, médico o motivo" HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#buscar" styleClass="btn-secondary" text="Buscar" />
                </HBox>
                <TableView fx:id="tblCitas" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="50" text="ID" />
                        <TableColumn fx:id="colPaciente" prefWidth="160" text="Paciente" />
                        <TableColumn fx:id="colMedico" prefWidth="160" text="Médico" />
                        <TableColumn fx:id="colFecha" prefWidth="90" text="Fecha" />
                        <TableColumn fx:id="colHora" prefWidth="70" text="Hora" />
                        <TableColumn fx:id="colMotivo" prefWidth="160" text="Motivo" />
                        <TableColumn fx:id="colEstado" prefWidth="110" text="Estado" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>
