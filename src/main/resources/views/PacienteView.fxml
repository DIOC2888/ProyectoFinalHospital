<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@../css/estilos.css" fx:controller="org.example.proyectofinalhospital.controller.PacienteController" prefHeight="660.0" prefWidth="940.0" spacing="14.0" styleClass="modulo">
    <padding>
        <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
    </padding>
    <children>
        <Label styleClass="titulo" text="Gestión de pacientes" />
        <Label styleClass="subtitulo" text="Registre, consulte y actualice la información de los pacientes." />

        <!-- ============ FORMULARIO ============ -->
        <VBox spacing="14.0" styleClass="card">
            <children>
                <GridPane hgap="14.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="130.0" prefWidth="150.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                        <ColumnConstraints minWidth="130.0" prefWidth="150.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                    </columnConstraints>
                    <children>
            <Label styleClass="campo-label" text="Nombres" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtNombres" promptText="Nombres del paciente" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label styleClass="campo-label" text="Apellidos" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <TextField fx:id="txtApellidos" promptText="Apellidos del paciente" GridPane.columnIndex="3" GridPane.rowIndex="0" />
            <Label styleClass="campo-label" text="Documento de identidad" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="txtDocumento" promptText="Cédula o pasaporte" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label styleClass="campo-label" text="Fecha de nacimiento" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <DatePicker fx:id="dpFechaNacimiento" maxWidth="Infinity" promptText="dd/mm/aaaa" GridPane.columnIndex="3" GridPane.rowIndex="1" />
            <Label styleClass="campo-label" text="Teléfono" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="txtTelefono" promptText="Ej. 8888-8888" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label styleClass="campo-label" text="Correo" GridPane.columnIndex="2" GridPane.rowIndex="2" />
            <TextField fx:id="txtCorreo" promptText="correo@ejemplo.com" GridPane.columnIndex="3" GridPane.rowIndex="2" />
            <Label styleClass="campo-label" text="Dirección" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <TextField fx:id="txtDireccion" promptText="Dirección de residencia" GridPane.columnIndex="1" GridPane.rowIndex="3" GridPane.columnSpan="3" />
            <Label styleClass="campo-label" text="Contacto de emergencia" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <TextField fx:id="txtContactoEmergencia" promptText="Nombre del contacto" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <Label styleClass="campo-label" text="Teléfono de emergencia" GridPane.columnIndex="2" GridPane.rowIndex="4" />
            <TextField fx:id="txtTelefonoEmergencia" promptText="Ej. 8888-8888" GridPane.columnIndex="3" GridPane.rowIndex="4" />
            <Label styleClass="campo-label" text="Estado" GridPane.columnIndex="0" GridPane.rowIndex="5" />
            <CheckBox fx:id="chkActivo" selected="true" text="Paciente activo" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                    </children>
                </GridPane>
                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardar" styleClass="btn-primary" text="Guardar" />
                        <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#actualizar" styleClass="btn-secondary" text="Actualizar" />
                        <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiar" styleClass="btn-secondary" text="Limpiar" />
                        <Button fx:id="btnDesactivar" mnemonicParsing="false" onAction="#desactivar" styleClass="btn-danger" text="Desactivar" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- ============ LISTADO ============ -->
        <VBox spacing="10.0" styleClass="card" VBox.vgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label styleClass="campo-label" text="Buscar:" />
                    <TextField fx:id="txtBuscar" promptText="Buscar por nombre o documento" HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#buscar" styleClass="btn-secondary" text="Buscar" />
                </HBox>
                <TableView fx:id="tblPacientes" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="50" text="ID" />
                        <TableColumn fx:id="colNombres" prefWidth="130" text="Nombres" />
                        <TableColumn fx:id="colApellidos" prefWidth="130" text="Apellidos" />
                        <TableColumn fx:id="colDocumento" prefWidth="110" text="Documento" />
                        <TableColumn fx:id="colFechaNacimiento" prefWidth="100" text="Nacimiento" />
                        <TableColumn fx:id="colTelefono" prefWidth="100" text="Teléfono" />
                        <TableColumn fx:id="colCorreo" prefWidth="160" text="Correo" />
                        <TableColumn fx:id="colActivo" prefWidth="70" text="Estado" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>
