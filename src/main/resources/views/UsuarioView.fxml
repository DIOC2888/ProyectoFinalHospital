<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@../css/estilos.css" fx:controller="org.example.proyectofinalhospital.controller.UsuarioController" prefHeight="660.0" prefWidth="940.0" spacing="14.0" styleClass="modulo">
    <padding>
        <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
    </padding>
    <children>
        <Label styleClass="titulo" text="Gestión de usuarios" />
        <Label styleClass="subtitulo" text="Administre las cuentas de acceso al sistema." />

        <!-- ============ FORMULARIO ============ -->
        <VBox spacing="14.0" styleClass="card">
            <children>
                <GridPane hgap="14.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="130.0" prefWidth="150.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                        <ColumnConstraints minWidth="130.0" prefWidth="150.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                    </columnConstraints>
                    <children>
            <Label styleClass="campo-label" text="Nombre de usuario" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtUsername" promptText="Usuario de acceso" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label styleClass="campo-label" text="Contraseña" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <PasswordField fx:id="pfContrasena" promptText="Contraseña" GridPane.columnIndex="3" GridPane.rowIndex="0" />
            <Label styleClass="campo-label" text="Rol" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <ComboBox fx:id="cmbRol" maxWidth="Infinity" promptText="Seleccione el rol" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="ADMINISTRADOR" />
                        <String fx:value="RECEPCIONISTA" />
                    </FXCollections>
                </items>
            </ComboBox>
            <Label styleClass="campo-label" text="Estado" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <CheckBox fx:id="chkActivo" selected="true" text="Usuario activo" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                    </children>
                </GridPane>
                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardar" styleClass="btn-primary" text="Guardar" />
                        <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#actualizar" styleClass="btn-secondary" text="Actualizar" />
                        <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiar" styleClass="btn-secondary" text="Limpiar" />
                        <Button fx:id="btnDesactivar" mnemonicParsing="false" onAction="#desactivar" styleClass="btn-danger" text="Desactivar" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- ============ LISTADO ============ -->
        <VBox spacing="10.0" styleClass="card" VBox.vgrow="ALWAYS">
            <children>
                <TableView fx:id="tblUsuarios" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="50" text="ID" />
                        <TableColumn fx:id="colUsername" prefWidth="200" text="Usuario" />
                        <TableColumn fx:id="colRol" prefWidth="150" text="Rol" />
                        <TableColumn fx:id="colActivo" prefWidth="90" text="Estado" />
                        <TableColumn fx:id="colFechaCreacion" prefWidth="160" text="Fecha de creación" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>
