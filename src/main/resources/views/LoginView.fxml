<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@../css/estilos.css" fx:controller="org.example.proyectofinalhospital.controller.LoginController" prefHeight="560.0" prefWidth="860.0" styleClass="login-fondo">
    <children>
        <VBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="380.0" spacing="8.0" styleClass="login-card">
            <children>
                <Label styleClass="login-logo" text="SIGAH" />
                <Label styleClass="subtitulo" text="Sistema Integral de Gestión Administrativa Hospitalaria" wrapText="true" />

                <Label styleClass="campo-label" text="Usuario">
                    <VBox.margin>
                        <Insets top="16.0" />
                    </VBox.margin>
                </Label>
                <TextField fx:id="txtUsuario" promptText="Ingrese su usuario" />

                <Label styleClass="campo-label" text="Contraseña">
                    <VBox.margin>
                        <Insets top="6.0" />
                    </VBox.margin>
                </Label>
                <PasswordField fx:id="pfContrasena" promptText="Ingrese su contraseña" />

                <Label fx:id="lblError" minHeight="34.0" styleClass="error-label" text="" wrapText="true" />

                <Button fx:id="btnIniciarSesion" defaultButton="true" maxWidth="Infinity" mnemonicParsing="false" onAction="#iniciarSesion" styleClass="btn-primary" text="Iniciar sesión" />
            </children>
        </VBox>
    </children>
</StackPane>
