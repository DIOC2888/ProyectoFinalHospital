<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@../css/estilos.css" fx:controller="org.example.proyectofinalhospital.controller.EspecialidadController" prefHeight="660.0" prefWidth="940.0" spacing="14.0" styleClass="modulo">
    <padding>
        <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
    </padding>
    <children>
        <Label styleClass="titulo" text="Gestión de especialidades" />
        <Label styleClass="subtitulo" text="Mantenga el catálogo de especialidades médicas." />

        <!-- ============ FORMULARIO ============ -->
        <VBox spacing="14.0" styleClass="card">
            <children>
                <GridPane hgap="14.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="130.0" prefWidth="150.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                        <ColumnConstraints minWidth="130.0" prefWidth="150.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                    </columnConstraints>
                    <children>
            <Label styleClass="campo-label" text="Nombre" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtNombre" promptText="Nombre de la especialidad" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.columnSpan="3" />
            <Label styleClass="campo-label" text="Descripción" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextArea fx:id="txtDescripcion" prefRowCount="3" wrapText="true" promptText="Descripción (opcional)" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.columnSpan="3" />
                    </children>
                </GridPane>
                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardar" styleClass="btn-primary" text="Guardar" />
                        <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#actualizar" styleClass="btn-secondary" text="Actualizar" />
                        <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiar" styleClass="btn-secondary" text="Limpiar" />
                        <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminar" styleClass="btn-danger" text="Eliminar" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- ============ LISTADO ============ -->
        <VBox spacing="10.0" styleClass="card" VBox.vgrow="ALWAYS">
            <children>
                <TableView fx:id="tblEspecialidades" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="50" text="ID" />
                        <TableColumn fx:id="colNombre" prefWidth="200" text="Nombre" />
                        <TableColumn fx:id="colDescripcion" prefWidth="400" text="Descripción" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>
